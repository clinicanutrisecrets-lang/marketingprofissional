# ============================================================
# MARKETING PROFISSIONAL — MONOREPO
# Scanner da Saúde Franquia + Studio Aline
# ============================================================
# Copie para .env.local em cada app e preencha os valores.
# Na Vercel, adicione em Settings → Environment Variables dos 2 projetos.

# ============================================================
# SUPABASE (compartilhado — mesmo projeto, schemas separados)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://mfldshdxulqxskwcoxrl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_f_B21kGZx3mnTjHPDJ5svQ_L0SMaVFv
SUPABASE_SERVICE_ROLE_KEY=  # Pegar em Supabase → Settings → API → service_role

# ============================================================
# ANTHROPIC (compartilhado — 1 key master)
# ============================================================
ANTHROPIC_API_KEY=  # sk-ant-api03-... (gerar em console.anthropic.com)

# ============================================================
# WORKERS DE VÍDEO (GitHub Actions) — reel animado e corte com IA
# ============================================================
# PAT com permissão Actions:write neste repo. A plataforma dispara os
# workflows render-reel.yml e render-corte.yml via workflow_dispatch.
GITHUB_ACTIONS_TOKEN=
# Corte com IA (teste fechado): e-mails liberados, separados por vírgula.
# Sem a variável vale a conta da Aline. "*" abre pra todas as franqueadas.
CORTE_IA_EMAILS=
# Franqueada dona da biblioteca de b-roll compartilhada (coringas). Opcional.
CORTE_BROLL_FRANQUEADA_ID=

# ============================================================
# META (compartilhado — 1 app, 2 contextos de uso)
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI_FRANQUIAS=https://marketingprofissional.vercel.app/api/auth/meta/callback
META_REDIRECT_URI_ALINE=https://studio-aline.vercel.app/api/auth/meta/callback

# Pixel unico da marca Scanner da Saude — dispara na LP /nutri/[slug]
# Eventos: PageView (auto), ViewContent (scroll >50%), Lead (click WhatsApp)
# ID em business.facebook.com → Events Manager → Data Sources
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API (server-side) — dispara Schedule R$650 e Purchase R$1800
# META_PIXEL_ID = mesmo valor de NEXT_PUBLIC_META_PIXEL_ID (so facilita leitura server)
# META_CAPI_ACCESS_TOKEN = gere em Events Manager → seu Pixel → Settings → Generate Access Token
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Kiwify webhook — dispara Purchase pro CAPI quando compra e aprovada
# Gerar secret em painel Kiwify → Webhooks. Recomendado: random 64 chars.
KIWIFY_WEBHOOK_SECRET=

# Sofia (WhatsApp IA) — endpoint /api/conversions/schedule autentica com este token
# quando Sofia marca um agendamento confirmado (dispara CAPI Schedule R$650)
SOFIA_INTERNAL_TOKEN=

# ============================================================
# AI IMAGE — Geração de imagens (feed, carrossel, stories)
# ============================================================
# Substitui Bannerbear. Creatomate segue apenas para vídeo/reels.
# Studio Aline usa OpenAI (qualidade premium).
# Franquias usam Gemini (custo viável em escala).
OPENAI_API_KEY=    # platform.openai.com/api-keys
GEMINI_API_KEY=    # aistudio.google.com/app/apikey

# ============================================================
# CANVA CONNECT API — Pipeline de duplicate-and-edit (Studio Aline)
# ============================================================
# Substitui Sharp composite legado por designs reais do Canva.
# Cria app em https://www.canva.com/developers/integrations/connect-api
# Scopes mínimos: design:content:read design:content:write design:meta:read
#                 asset:read asset:write
CANVA_CLIENT_ID=        # Client ID do integration (Canva Developer Portal)
CANVA_CLIENT_SECRET=    # Client Secret
CANVA_REDIRECT_URI=https://studio-aline.vercel.app/api/canva/callback
# Localmente: http://localhost:3001/api/canva/callback

# ============================================================
# PEXELS — Fotos hero pra pipeline Canva
# ============================================================
PEXELS_API_KEY=         # pexels.com/api

# ============================================================
# INTEGRACAO CROSS-PROJETO (Scanner SaaS ↔ Marketing)
# ============================================================
# Dois projetos Vercel, dois bancos Supabase, comunicam via webhooks.
# Secrets trocados como HMAC SHA256 do body da requisicao.
# Rotacionar a cada 90 dias.
SCANNER_SAAS_URL=https://scannerdasaude.com
SCANNER_WEBHOOK_SECRET=    # Marketing assina chamadas pro SaaS + valida chamadas do SaaS
MARKETING_WEBHOOK_SECRET=  # Bearer que o Marketing usa pra LER o SaaS (GET /api/integrations/marketing/produtos — sync do catálogo do Scanner Tratamentos)
MARKETING_SSO_SECRET=      # JWT HS256 do SSO Scanner → Marketing (rota /sso). MESMO valor no Vercel do scanner-saude. Ver docs/SSO_MARKETING.md do repo scanner-saude

# ============================================================
# BANNERBEAR (LEGADO — a aposentar)
# ============================================================
# Mantém só enquanto a migração pra @scanner/ai-image roda em
# paralelo. Após 1 semana de validação, cancela no Bannerbear e
# remove estas vars + o pacote packages/bannerbear.
BANNERBEAR_API_KEY=
BANNERBEAR_PROJECT_ID=
BANNERBEAR_TEMPLATE_FEED_IMAGEM=
BANNERBEAR_TEMPLATE_REELS_COVER=
BANNERBEAR_TEMPLATE_CARROSSEL=

# ============================================================
# RESEND (compartilhado)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=contato@scannerdasaude.com

# ============================================================
# HEYGEN (APENAS apps/aline — uso pessoal)
# ============================================================
# No plano Creator, API não está disponível — fluxo manual.
# Upgrade pra API plan ($99/mês) habilita integração programática.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_API_ENABLED=false  # true quando fizer upgrade

# ============================================================
# PUBLER — Agendamento orgânico (substitui Meta API enquanto review não vem)
# ============================================================
# 1. Criar conta agência em app.publer.com
# 2. Criar UMA workspace "Scanner da Saúde"
# 3. Settings → Access & Login → API Keys → gerar chave
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=        # ID da workspace (aparece na URL)
NEXT_PUBLIC_PUBLER_WORKSPACE_ID=  # mesmo valor — exposto no front para o link de conexão
                                  # SEM ele, o bloco "Conectar Instagram" some do onboarding
                                  # (em vez de mostrar link quebrado) — ver src/lib/features.ts

# ============================================================
# META ADS / BUSINESS MANAGER — desligado até a aprovação sair
# ============================================================
# Enquanto o app não é aprovado pela Meta, o onboarding NÃO mostra
# "vincular Página do Facebook" nem promete anúncios. Quando a
# aprovação sair, setar NEXT_PUBLIC_META_ADS_ATIVO=true.
NEXT_PUBLIC_META_ADS_ATIVO=

# ============================================================
# META BUSINESS MANAGER — Ads sem App Review
# ============================================================
# Setup manual UMA VEZ em business.facebook.com:
# 1. Configurações → Usuários do sistema → Criar usuário admin
# 2. Gerar token permanente: escopos ads_management, business_management, pages_manage_ads
# 3. Anotar o ID do Business Manager (aparece na URL do BM)
META_BM_ID=                       # ID do Business Manager da Scanner
META_BM_SYSTEM_USER_TOKEN=        # Token permanente do System User

# ============================================================
# META ADS OAUTH — Agente de tráfego
# ============================================================
# Mesmo META_APP_ID/SECRET do Instagram. Só adicionar novo redirect URI
# em developers.facebook.com → seu app → Facebook Login → Valid OAuth Redirect URIs
META_ADS_REDIRECT_URI=https://app.scannerdasaude.com/api/auth/meta/ads/callback
# Localmente: http://localhost:3000/api/auth/meta/ads/callback

# ============================================================
# SEGURANÇA
# ============================================================
ENCRYPTION_KEY=  # 32 bytes em base64: openssl rand -base64 32

# ============================================================
# URLs
# ============================================================
NEXT_PUBLIC_APP_URL_FRANQUIAS=http://localhost:3000
NEXT_PUBLIC_APP_URL_ALINE=http://localhost:3001
