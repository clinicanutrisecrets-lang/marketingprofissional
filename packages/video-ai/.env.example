# ============================================================
# NUTRI VIDEO AI (packages/video-ai) — copie para .env nesta pasta
# ============================================================

# fal.ai — único provedor externo (treino de LoRA + geração Wan 2.2).
# Pegar em fal.ai → Dashboard → Keys.
FAL_KEY=

# Anthropic — só pra escrever as legendas do dataset (visão). Sem a chave, o
# preparo usa o nome do arquivo como legenda e avisa.
ANTHROPIC_API_KEY=
# Modelo das legendas (opcional). Padrão: claude-opus-5.
VIDEO_AI_LEGENDA_MODEL=

# Supabase do Marketing (mesmo projeto do Studio Aline). O preparo cria o
# bucket privado `video-ai` sozinho e o treino grava em aline.video_loras.
# Sem as duas variáveis, o pacote sobe pro storage da própria fal (aviso) e o
# registro fica só em loras.json.
NEXT_PUBLIC_SUPABASE_URL=https://mfldshdxulqxskwcoxrl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket (opcional). Padrão: video-ai
VIDEO_AI_BUCKET=

# Frase-gatilho que abre TODA legenda e TODO prompt de geração (opcional).
# Padrão: "nutrisecrets style". Mudar depois de treinar invalida o LoRA.
VIDEO_AI_TRIGGER=

# Preço por passo do trainer da fal, em US$ (opcional). Padrão: 0.004.
# Só entra na estimativa de custo mostrada no terminal e gravada no registro.
FAL_PRECO_PASSO_USD=
